{
  "name": "ryanbeck-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "serve": "python3 -m http.server 8000 --directory public",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node tools/check-links.mjs && node tools/check-docs.mjs && node tools/site-url.mjs",
    "site-url": "node tools/site-url.mjs --write",
    "copy": "node tools/copy.mjs extract",
    "copy-apply": "node tools/copy.mjs apply",
    "edit": "node tools/copy-server.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
