{
  "name": "ryanbeck-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "serve": "python3 -m http.server 8000 --directory public",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node tools/check-links.mjs && node tools/check-docs.mjs && node tools/site-url.mjs && node tools/check-public-data.mjs",
    "predeploy": "npm test",
    "site-url": "node tools/site-url.mjs --write",
    "copy": "node tools/copy.mjs extract",
    "copy-apply": "node tools/copy.mjs apply",
    "edit": "node tools/copy-server.mjs",
    "about-plain": "node tools/build-about-plain.mjs",
    "blog-build": "python tools/build-blog.py"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
