/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Nothing here has a content hash in its filename, so "immutable" would pin
# a returning visitor to year-old assets after every deploy.
#
# Everything revalidates while the site's content is still being built out.
# The 4h image policy this replaced was a real trap: swapped artwork kept
# showing as the old file, and it is impossible to tell "you cached it" from
# "I broke it" over a screenshot. Assets here are small and the site is not
# yet public; correctness of what the author sees beats edge bandwidth.
#
# BEFORE LAUNCH: put the images back on a long max-age (a year is fine) and
# add a content hash to their filenames so a swap busts the cache by itself.
/assets/*
  Cache-Control: no-cache

/assets/css/*
  ! Cache-Control
  Cache-Control: no-cache

/assets/js/*
  ! Cache-Control
  Cache-Control: no-cache

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/api/*
  Cache-Control: no-store
